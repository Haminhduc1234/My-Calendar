{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static",
      "config": {
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/api/cron/check-reminders",
      "dest": "/api/check-reminders.js"
    },
    {
      "src": "/api/check-reminders",
      "dest": "/api/check-reminders.js"
    },
    {
      "src": "/api/send-push",
      "dest": "/api/send-push.js"
    },
    {
      "src": "/api/([^.]+)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-reminders",
      "schedule": "*/5 * * * *"
    }
  ]
}
